# ==========================================
# CiteVerify Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
!**/.env.example

# Python Virtual Environments
.venv/
venv/
env/
ENV/
*.venv/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo
.Python
*.egg-info/
dist/
build/

# Testing & Coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.pytest_tmp

# SQLite & Databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Uploads & Temporary Reports
uploads/
reports/
**/uploads/*
!**/uploads/.gitkeep
**/reports/*
!**/reports/.gitkeep

# Node / Frontend
node_modules/
.npm/
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.output/
.nitro/
.wrangler/
dist/
build/
.cache/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Temporary test generation artifacts (optional, keep fixtures clean)
test_pipeline_e2e.py
test_documents/
