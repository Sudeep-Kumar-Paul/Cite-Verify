# Server Configuration
PORT=8000
APP_NAME=CiteVerify
APP_ENV=production
DEBUG=false
SECRET_KEY=change_this_secret_key_in_production

# CORS - Allowed Frontend Origins (comma-separated or * for wildcard)
ALLOWED_ORIGINS=https://cite-verify-production.up.railway.app,http://localhost:5173,http://localhost:3000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_from_aistudio_google_com
GEMINI_MODEL=gemini-3.8-flash

# Database (SQLite by default; PostgreSQL supported on Railway automatically)
DATABASE_URL=sqlite:///./citeverify.db

# File Upload Settings (supports PDF, DOCX, TXT)
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads
REPORTS_DIR=reports

# External Academic APIs (optional)
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_EMAIL=your_email@example.com

# Rate Limiting & Timeouts
EXTERNAL_API_TIMEOUT_SECONDS=30
MAX_RETRIES=3
