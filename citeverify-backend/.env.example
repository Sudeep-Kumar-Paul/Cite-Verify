# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Settings
APP_NAME=CiteVerify
APP_ENV=development
DEBUG=true
SECRET_KEY=change_this_secret_key_in_production

# CORS - Frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://localhost:8080

# File Upload Settings
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=uploads
REPORTS_DIR=reports

# Database
DATABASE_URL=sqlite:///./citeverify.db

# External APIs (optional - fallback gracefully if missing)
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_EMAIL=your_email@example.com

# Rate limiting
EXTERNAL_API_TIMEOUT_SECONDS=30
MAX_RETRIES=3
