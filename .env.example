# ==========================================
# CiteVerify Global Deployment Environment
# ==========================================

# --- Required: AI Engine ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- Backend Security & Configuration ---
SECRET_KEY=generate_a_random_32_character_secret_key_here
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- CORS & API Integration ---
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URL of the backend (accessed by the frontend client browser)
# For local Docker: http://localhost:8000
# For production: https://api.yourdomain.com or https://backend-service.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# --- Optional: External Academic APIs ---
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_EMAIL=researcher@example.com

# --- Optional: Firebase Authentication ---
# If left blank, CiteVerify's built-in Demo Auth mode will be active
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
